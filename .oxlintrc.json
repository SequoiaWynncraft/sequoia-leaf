{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise"],
  "jsPlugins": ["./packages/kit/tools/lint-rules.mjs"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "typescript/consistent-return": "off",
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": ["react", "preact", "solid-js", "vue"],
        "patterns": ["react/**", "preact/**", "solid-js/**", "vue/**"]
      }
    ],
    "leaf/hook-framework": "error",
    "leaf/raw-browser": "error",
    "leaf/module-let": "error",
    "leaf/said-number": "error"
  },
  "overrides": [
    {
      "files": ["apps/*/src/**", "apps/api/migrations/**", "packages/*/src/**"],
      "excludeFiles": [
        "**/*.test.ts",
        "packages/kit/src/standin.ts",
        "packages/kit/src/standin-gl.ts",
        "packages/raid/src/testkit.ts"
      ],
      "rules": {
        "max-lines": ["error", { "max": 500, "skipBlankLines": true, "skipComments": true }],
        "max-lines-per-function": ["error", { "max": 90, "skipBlankLines": true, "skipComments": true }],
        "complexity": ["error", { "max": 15 }]
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/test/**",
        "**/review/**",
        "**/tools/**",
        "packages/kit/src/standin.ts",
        "packages/kit/src/standin-gl.ts",
        "packages/raid/src/testkit.ts",
        "packages/factory/*.ts",
        "packages/factory/pace/**"
      ],
      "rules": {
        "leaf/raw-browser": "off",
        "leaf/module-let": "off",
        "leaf/said-number": "off"
      }
    },
    {
      "files": ["packages/core/src/say.ts"],
      "rules": {
        "leaf/said-number": "off"
      }
    },
    {
      "files": ["packages/kit/src/scope.ts"],
      "rules": {
        "leaf/raw-browser": "off"
      }
    }
  ]
}
