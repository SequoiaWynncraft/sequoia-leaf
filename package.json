{
  "name": "sequoia-leaf",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "bun@1.4.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "verify": "bun fmt --check && bun run lint && bun check --build && bun run test && bun run imports && bun run clones && bun run budget && bun run pages",
    "ci": "DOCKER_HOST=${DOCKER_HOST:-unix://$(test -w /var/run/docker.sock && echo /var/run/docker.sock || echo $XDG_RUNTIME_DIR/podman/podman.sock)} act pull_request --workflows .github/workflows/ci.yml --platform ubuntu-24.04=docker.io/catthehacker/ubuntu:act-24.04 --pull=false --action-offline-mode --container-options=--init --rm",
    "lint": "bun packages/kit/tools/lint.ts",
    "imports": "bun packages/kit/tools/imports.ts",
    "clones": "bun packages/kit/tools/clones.ts",
    "budget": "bun packages/kit/tools/budget.ts",
    "pages": "bun packages/kit/tools/pages.ts",
    "test": "bun run --filter '*' test --timeout=20000",
    "dev": "bun run --filter @sequoia-leaf/api dev",
    "start": "bun apps/api/src/main.ts"
  },
  "devDependencies": {
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007"
  }
}
