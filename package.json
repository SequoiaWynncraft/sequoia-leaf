{
  "name": "sequoia-leaf",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "7.0.2",
      "vitest": "5.1.0"
    }
  },
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run test",
    "lint": "biome ci",
    "fix": "biome check --write",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "dev": "bun run --filter @sequoia-leaf/api dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7"
  }
}
