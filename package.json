{
  "name": "sequoia-leaf",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "verify": "bun fmt --check && bun run lint && bun run types && bun check --build && bun run test",
    "lint": "oxlint --type-aware --deny-warnings",
    "types": "bun run --filter @sequoia-leaf/api types",
    "test": "bun run --filter '*' test",
    "dev": "bun run --filter @sequoia-leaf/api dev"
  },
  "devDependencies": {
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007"
  }
}
