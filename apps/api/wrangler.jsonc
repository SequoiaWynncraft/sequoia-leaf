{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sequoia-leaf",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sequoia-leaf",
      "migrations_dir": "migrations",
    },
  ],
}
